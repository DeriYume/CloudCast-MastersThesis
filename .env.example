# --- Database ---
# admin role; yours, for psql and migrations
POSTGRES_USER=mycloud
# database name
POSTGRES_DB=mycloud
# admin password; required
POSTGRES_PASSWORD=
# least-privilege role the services connect as
APP_DB_USER=cloudcast_app
# its password; required - openssl rand -hex 32
APP_DB_PASSWORD=

# --- pgAdmin (tools profile, 127.0.0.1 only) ---
# pgAdmin email; local dev only
PGADMIN_EMAIL=admin@admin.com
# pgAdmin password; local dev only
PGADMIN_PASSWORD=admin

# --- Secrets - all required, generated once ---
# signs session tokens - openssl rand -hex 32
JWT_SECRET=
# authenticates gateway to services - openssl rand -hex 32
INTERNAL_KEY=
# peppers the email lookup hash; 64 hex chars
BLIND_INDEX_PEPPER=
# encrypts stored email addresses; 64 hex chars
EMAIL_ENC_KEY=
# opens AI grants only; base64 of 32 bytes
SERVER_X25519_SK=

# --- Android client ---
# gateway URL the Android app is built against
API_URL=https://192.168.x.x:8443/

# --- Compose profiles ---
# optional services: ai (Ollama), tools (pgAdmin)
COMPOSE_PROFILES=ai,tools

# --- Local AI - needs the ai profile ---
# master switch for AI features
AI_ENABLED=false
# allow semantic search
AI_SEMANTIC_ENABLED=false
# where Ollama listens
OLLAMA_URL=http://ollama:11434
# model for text; lighter: llama3.2:1b
AI_TEXT_MODEL=llama3.2:3b
# model for images; llava:7b is sharper but needs ~5 GB free - it OOMs on an 8 GB card
AI_VISION_MODEL=moondream
# model for embeddings
AI_EMBED_MODEL=nomic-embed-text
# concurrent model requests
OLLAMA_NUM_PARALLEL=1
# how long models stay loaded; -1 pins them and can starve a larger model of VRAM
OLLAMA_KEEP_ALIVE=5m

# --- Retention ---
# how often the cleanup job runs
SWEEP_INTERVAL_MS=60000
# maximum age of a notification
NOTIF_RETENTION_DAYS=30
# how long spent AI grants are kept
AI_GRANT_RETENTION_HOURS=0
# delay before a deletion is final, and the cancel window;
ACCOUNT_PURGE_GRACE_DAYS=30

# --- Limits ---
# largest single upload, MB
MAX_UPLOAD_MB=25
# largest image the analyzer accepts, MB
AI_MAX_IMAGE_MB=25
# characters of a file sent to the model; keep under the embed model's context (~2048 tokens)
AI_MAX_TEXT_CHARS=4000
# concurrent AI jobs per user
AI_MAX_PER_USER=2
# per model-call timeout, ms; must cover a cold model load, not just inference
AI_TIMEOUT_MS=180000
# wait for the document extractor, ms
EXTRACT_TIMEOUT_MS=25000
# characters returned per document
EXTRACT_MAX_CHARS=20000
# gateway requests per minute per IP
RATE_LIMIT_PER_MIN=1000
